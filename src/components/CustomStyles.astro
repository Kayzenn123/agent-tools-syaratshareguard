---
// SyaratShareGuard — token desain (seed 2026-10-21, dirapikan manual).
// Font dari Astro Fonts API: --font-display (Macondo Swash Caps),
// --font-body (SUSE), --font-stamp (Diplomata).
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-body);
    --aw-font-serif: var(--font-display);
    --aw-font-heading: var(--font-display);

    /* Palet: light / triadic / hue 224 — kertas fotokopi vs stempel */
    --aw-color-primary: #bb2d8e; /* stempel magenta */
    --aw-color-secondary: #051e27; /* tinta */
    --aw-color-accent: #ff7115; /* pop oranye */

    --aw-color-text-heading: #051e27;
    --aw-color-text-default: #051e27;
    --aw-color-text-muted: #495f67;
    --aw-color-bg-page: #e9f8fe;

    --sg-surface: #d5ecf6;
    --sg-lime: #bba700;
    --sg-ink: #051e27;

    /* Constraint seed: HANYA 3 ukuran font di seluruh situs */
    --fs-xs: 0.75rem; /* 12px — label, keterangan, footnote */
    --fs-md: 1.0625rem; /* 17px — body */
    --fs-xl: clamp(3.2rem, 13vw, 9rem); /* raksasa — display */

    /* Motion tokens (micro-interactions) */
    --ease-standard: cubic-bezier(0.2, 0, 0, 1);
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
    --dur-fast: 120ms;
    --dur-normal: 240ms;
    --dur-slow: 420ms;

    ::selection {
      background-color: #bb2d8e;
      color: #fff;
    }
  }

  .dark {
    --aw-font-sans: var(--font-body);
    --aw-font-serif: var(--font-display);
    --aw-font-heading: var(--font-display);
    --aw-color-primary: #bb2d8e;
    --aw-color-secondary: #e9f8fe;
    --aw-color-accent: #ff7115;
    --aw-color-text-heading: #e9f8fe;
    --aw-color-text-default: #e9f8fe;
    --aw-color-text-muted: #a9c3cd;
    --aw-color-bg-page: #0b1418;
    --sg-surface: #12242c;
    --sg-lime: #d3bd00;
    --sg-ink: #e9f8fe;
    ::selection {
      background-color: #bb2d8e;
      color: #fff;
    }
  }
</style>

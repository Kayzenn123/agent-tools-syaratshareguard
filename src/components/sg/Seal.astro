---
// Badge stempel melingkar — teks di path melengkung (motion C), CSS rotate.
interface Props { text?: string; size?: number }
const { text = 'SYARAT TERPENUHI • JANGAN SPAM • ', size = 120 } = Astro.props;
const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class="sg-seal" width={size} height={size} viewBox="0 0 120 120" role="img" aria-label="Stempel syarat">
  <defs><path id={id} d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
  <circle cx="60" cy="60" r="56" fill="none" stroke="var(--aw-color-primary)" stroke-width="3" />
  <circle cx="60" cy="60" r="32" fill="none" stroke="var(--aw-color-primary)" stroke-width="2" />
  <text font-size="12.5" letter-spacing="2.5" fill="var(--aw-color-primary)" style="font-family:var(--font-stamp)">
    <textPath href={`#${id}`}>{text}</textPath>
  </text>
  <text x="60" y="66" text-anchor="middle" font-size="17" fill="var(--aw-color-primary)" style="font-family:var(--font-stamp)">SAH</text>
</svg>
